# Export these variables in your shell; this module does not auto-load .env.
# Full HTTPS chat-completions-compatible URL, or a localhost HTTP URL.
MODEL_ENDPOINT=
MODEL_NAME=
MODEL_API_KEY=
# Optional comma-separated exact model IDs supplied by organizers. No guessed list.
MODEL_APPROVED_MODELS=

# Optional JSON request options; only supported provider parameters are allowed.
# NVIDIA Lightning candidate: disable thinking, require JSON, and bound output.
# MODEL_OPTIONS_JSON={"temperature":0,"max_tokens":8192,"response_format":{"type":"json_object"},"chat_template_kwargs":{"enable_thinking":false}}

# Optional strict extraction: enable only on a model supporting strict JSON schema.
MODEL_STRICT_EXTRACTION=0
# Groq comparison (keys stay local). Export MODEL_API_KEY from the chosen key.
GROQ_API_KEY=
# MODEL_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
# MODEL_NAME=openai/gpt-oss-20b
# MODEL_STRICT_EXTRACTION=1
# MODEL_OPTIONS_JSON={"temperature":0,"max_tokens":5000,"reasoning_effort":"low"}

# Gemini free-tier-eligible comparison; keep your project on its free tier.
GEMINI_API_KEY=
# MODEL_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# MODEL_NAME=gemini-3.5-flash-lite
# Export MODEL_API_KEY from GEMINI_API_KEY (or GEMINI_API if that is your local name).
# MODEL_STRICT_EXTRACTION=1
# MODEL_OPTIONS_JSON={"temperature":0,"max_tokens":8192}

# Record a second extraction review to check omissions and semantic mappings.
MODEL_VERIFY_EXTRACTION=1
